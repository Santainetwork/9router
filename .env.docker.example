# 9Router Docker Environment Configuration
# Copy this file to .env and adjust values before running: docker compose up -d

# ─── System Branding ────────────────────────────────────────────────────────
APP_NAME=SantaiNetwork

# ─── Ports ──────────────────────────────────────────────────────────────────
# Master Gateway: Web Dashboard & LLM API (/v1, /v2, /responses)
GATEWAY_PORT=20128

# Public Proxy: Usage Check & Documentation (/usage-check, /docs)
PUBLIC_PORT=20140

# ─── Security Secrets (Auto-generated by install-docker.sh) ─────────────────
JWT_SECRET=replace_with_a_long_random_hex_secret
MACHINE_ID_SALT=replace_with_a_random_salt_hex
API_KEY_SECRET=replace_with_a_random_api_key_secret

# Initial Admin Password for the Web Dashboard (leave empty to auto-generate per
# install; the value is logged at startup and stored in the data volume)
INITIAL_PASSWORD=

# ─── Database Selection ─────────────────────────────────────────────────────
# By default, 9Router uses high-performance SQLite inside the Docker data volume.
# SQLite is always single-process. To use external PostgreSQL and multicore,
# uncomment both lines:
# DATABASE_URL=postgres://user:password@host:5432/9router
# API_WORKERS=3
# Or use the bundled database: ./install-docker.sh --postgres --yes
# POSTGRES_PASSWORD=replace_with_a_long_random_secret
# BUNDLED_DATABASE_URL=postgres://9router:replace_with_a_long_random_secret@postgres:5432/9router
# BUNDLED_API_WORKERS=3

# ─── Opt-in SQLite Redis multicore (private Redis broker) ───────────────────
# Enable with: ./install-docker.sh --sqlite-redis --yes
# Requires API_WORKERS>=2, ENABLE_GO_HYBRID=true, and a private Redis.
# SQLITE_QUEUE_ENCRYPTION_KEY must differ from API_KEY_SECRET and REDIS_PASSWORD.
# SQLITE_MULTICORE=redis
# REDIS_URL=redis://:replace_with_a_long_random_secret@redis:6379/0
# REDIS_PASSWORD=replace_with_a_long_random_secret
# SQLITE_QUEUE_ENCRYPTION_KEY=replace_with_a_distinct_64_hex_key
# BUNDLED_SQLITE_REDIS=1
# REDIS_MAXMEMORY=256mb

# ─── Concurrency & Hybrid Engine ────────────────────────────────────────────
ENABLE_GO_HYBRID=true
NODE_OPTIONS=--max-old-space-size=512

[Unit]
Description=9Router AI gateway (rate-limit build, port 20130)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# Separate data dir so this instance never shares the SQLite file with the
# production :20128 service (avoids dual-writer lock/corruption). Login password,
# JWT secret and machine-id were copied from prod, so credentials match.
Environment=HOME=/var/lib/9router-rl
# The Next.js standalone server reads PORT/HOSTNAME from the ENVIRONMENT and
# IGNORES --port/--host CLI flags (passing --port would silently bind :3000).
Environment=PORT=20130
Environment=HOSTNAME=::
Environment=ALLOWED_DEV_ORIGINS=192.168.105.9,192.168.105.9:20130
ExecStart=/usr/bin/node /opt/9router-release/custom-server.js --no-browser --log --skip-update
Restart=on-failure
RestartSec=5
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/9router-rl /opt/9router-release

[Install]
WantedBy=multi-user.target

# 9Router public-only reverse proxy (SantaiNetwork)
#
# Exposes ONLY the public surface — the self-contained /usage-check page (served
# from disk, no Next chunks) and the OpenAI-compatible /v1 + /api/v1 API — while
# hard-404ing everything admin (dashboard, /api/keys, /login, ...).
#
# Unlike the nginx option, this proxy serves usage-check.html itself, so it does
# NOT require the usage-check page to be deployed on the upstream and never has
# to expose /_next/static. Upstream only needs to provide /api/v1/usage.
#
# Install:
#   sudo cp deploy/9router-public-proxy.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now 9router-public-proxy
#
# Then point your edge (Cloudflare/Safeline/etc.) upstream at this host:20140.
#
# Tunables via the Environment lines below:
#   PORT      port this proxy listens on          (default 20140)
#   UPSTREAM  host:port of the 9router instance    (default 127.0.0.1:20128)

[Unit]
Description=9Router public-only reverse proxy (usage-check + /v1)
After=network.target

[Service]
Type=simple
Environment=PORT=20140
Environment=UPSTREAM=127.0.0.1:20128
ExecStart=/usr/bin/node /opt/9router/deploy/public-proxy.js
Restart=on-failure
RestartSec=2
# Hardening: this process only reads its own HTML file and opens a socket.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/9router/deploy

[Install]
WantedBy=multi-user.target
